 "html": "{%set letter_head=frappe.get_doc(\"Letter Head\",\"Hatch Letter Head\")%}\n<div class=\"booking-confirmation\">\n    <div class=\"booking-header\">\n    <img src=\"{{letter_head.image}}\" style=\"width:50px\">\n        <h1>Booking Confirmation</h1>\n        {% if doc.status == \"Pending Confirmation\" %}\n            <div class=\"confirmation-banner\">\n                NOT YET CONFIRMED \u2014 hold your seat\n            </div>\n        {% endif %}\n    </div>\n    \n    <div class=\"section\">\n        <h3>Member Details</h3>\n        <table class=\"details-table\">\n            <tr>\n                <td><strong>Member</strong></td>\n                <td>{{ doc.member }}</td>\n            </tr>\n            {% if doc.member_name %}\n            <tr>\n                <td><strong>Member Name</strong></td>\n                <td>{{ doc.member_name }}</td>\n            </tr>\n            {% endif %}\n        </table>\n    </div>\n\n    <div class=\"section\">\n        <h3>Resource & Schedule</h3>\n        <table class=\"details-table\">\n            <tr>\n                <td><strong>Resource</strong></td>\n                <td>{{ doc.resource }}</td>\n            </tr>\n            <tr>\n                <td><strong>Date</strong></td>\n                <td>{{ doc.booking_date }}</td>\n            </tr>\n            <tr>\n                <td><strong>Start Time</strong></td>\n                <td>{{ doc.start_time }}</td>\n            </tr>\n            <tr>\n                <td><strong>End Time</strong></td>\n                <td>{{ doc.end_time }}</td>\n            </tr>\n            <tr>\n                <td><strong>Headcount</strong></td>\n                <td>{{ doc.head_count }}</td>\n            </tr>\n            <tr>\n                <td><strong>Status</strong></td>\n                <td>{{ doc.status }}</td>\n            </tr>\n        </table>\n    </div>\n    \n    {% if doc.purpose %}\n    <div class=\"section\">\n        <h3>Purpose</h3>\n        <p>{{ doc.purpose }}</p>\n    </div>\n    {% endif %}\n    \n    <div class=\"section\">\n        <h3>Add-ons</h3>\n        {% if doc.addons %}\n        <table class=\"addons-table\">\n            <thead>\n                <tr>\n                    <th>Service</th>\n                    <th>Rate</th>\n                    <th>Quantity</th>\n                    <th>Amount</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for addon in doc.addons %}\n                <tr>\n                    <td>{{ addon.service_name }}</td>\n                    <td>\n                        {{ frappe.format_value(addon.rate, \"Currency\") }}\n                    </td>\n                    <td>{{ addon.quantity }}</td>\n                    <td>\n                        {{ frappe.format_value(addon.amount, \"Currency\") }}\n                    </td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n        {% else %}\n            <p>No add-ons selected.</p>\n        {% endif %}\n    </div>\n    \n    <div class=\"totals-section\">\n        <h3>Total</h3>\n        <div class=\"total-row\">\n            <span>Base Amount</span>\n            <span>\n                {{ frappe.format_value(doc.base_amount, \"Currency\") }}\n            </span><br>\n        </div>\n        <div class=\"total-row\">\n            <span>Add-ons Total</span>\n            <span>\n                {{ frappe.format_value(doc.addons_total, \"Currency\") }}\n            </span><br>\n        </div>\n        <div class=\"grand-total\">\n            <span>Total Amount</span>\n            <span>\n                {{ frappe.format_value(doc.total_amount, \"Currency\") }}\n            </span><br>\n        </div>\n    </div>\n</div>\n    ",
